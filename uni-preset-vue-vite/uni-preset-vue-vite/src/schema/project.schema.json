{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DawWeb Project",
  "description": "Shared project schema. schemaVersion 6 is the unified piano-roll Note model (ticks, advanced note fields, time-signature map).",
  "type": "object",
  "required": ["schemaVersion", "tempo", "tracks"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 6 },
    "projectVersion": { "type": "integer" },
    "name": { "type": "string" },
    "tempo": { "type": "number" },
    "timeSigNumerator": { "type": "integer" },
    "timeSigDenominator": { "type": "integer" },
    "masterGain": { "type": "number", "minimum": 0, "maximum": 1 },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "type": { "enum": ["master", "midi", "audio", "group"] },
          "parentId": { "type": "integer" },
          "collapsed": { "type": "boolean" },
          "instrumentId": { "type": "string" },
          "source": { "enum": ["empty", "remote-vst", "web-sampler", "m-orchestra"] },
          "technique": { "type": "string" },
          "legato": { "type": "boolean" },
          "controllers": { "type": "object" },
          "mute": { "type": "boolean" },
          "solo": { "type": "boolean" },
          "volume": { "type": "number" },
          "volumeDb": { "type": "number" },
          "pan": { "type": "number" },
          "sends": { "type": "array" },
          "inserts": { "type": "array", "maxItems": 5 },
        }
      }
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "notes": {
            "type": "array",
            "items": { "$ref": "#/$defs/note" }
          }
        }
      }
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "startBeat": { "type": "number" },
          "timeTick": { "type": "integer" },
          "section": { "type": "string" },
          "mode": { "type": "string" }
        }
      }
    },
    "timeSignatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timeTick": { "type": "integer" },
          "numerator": { "type": "integer" },
          "denominator": { "type": "integer" }
        }
      }
    },
    "score": {
      "type": "object",
      "properties": {
        "ppq": { "type": "integer" },
        "key": { "type": "string" },
        "scale": { "type": "string" },
        "timeSignatures": { "type": "array" },
        "markers": { "type": "array" }
      }
    },
    "webMixer": {
      "type": "object",
      "description": "Browser-owned mixer graph. Serializable plugin state only. No AudioNodes.",
      "properties": {
        "version": { "type": "integer" },
        "remote": {
          "type": "object",
          "properties": {
            "inserts": { "type": "array", "items": { "$ref": "#/$defs/webInsert" }, "maxItems": 5 },
            "sends": { "type": "array" }
          }
        },
        "tracks": { "type": "object" },
        "buses": { "type": "array" },
        "master": {
          "type": "object",
          "properties": {
            "inserts": { "type": "array", "items": { "$ref": "#/$defs/webInsert" }, "maxItems": 5 }
          }
        }
      }
    }
  },
  "$defs": {
    "note": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "pitch": { "type": "integer", "minimum": 0, "maximum": 127 },
        "startTick": { "type": "integer" },
        "durationTick": { "type": "integer" },
        "velocity": { "type": "number" },
        "releaseVelocity": { "type": "integer", "minimum": 1, "maximum": 127 },
        "pan": { "type": "integer", "minimum": 0, "maximum": 127 },
        "group": { "type": "integer" },
        "color": { "type": "integer", "minimum": 0, "maximum": 15 },
        "pitchOffset": { "type": "integer", "minimum": -120, "maximum": 120 },
        "muted": { "type": "boolean" },
        "slide": { "type": "boolean" },
        "porta": { "type": "boolean" },
        "repeatMode": { "type": "integer", "minimum": 0, "maximum": 14 },
        "modX": { "type": "integer", "minimum": 0, "maximum": 127 },
        "modY": { "type": "integer", "minimum": 0, "maximum": 127 }
      }
    },
    "webInsert": {
      "type": "object",
      "required": ["pluginId", "state"],
      "properties": {
        "instanceId": { "type": "string" },
        "pluginId": { "type": "string" },
        "version": { "type": "integer" },
        "enabled": { "type": "boolean" },
        "presetId": { "type": "string" },
        "state": { "type": "object" }
      }
    }
  }
}
